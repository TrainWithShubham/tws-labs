# ==============================================================================
# TWS Labs — Universal Environment Configuration (.env.example)
#
# Supports both:
# 1. Local execution through Docker Compose (zero-config defaults)
# 2. Remote browser-based execution through hosted deployment behind reverse proxy
# ==============================================================================

# --- Operating Mode ---
# "local"  : Local execution. Loopback binding, no invite tokens needed, relaxed limits, offline fonts.
# "hosted" : Hosted deployment. Strict Origin matching, invite token checks, tighter limits.
LAB_PROFILE=local

# --- Network & Server Binding ---
# IP address on the host to bind port 8080.
# Local mode defaults to 127.0.0.1 (secure loopback-only, never exposed to LAN).
# Hosted / reverse proxy deployment: set to 0.0.0.0 or container internal interface.
LABS_BIND_IP=127.0.0.1
LABS_PORT=8080

# --- Allowed Hosts & Reverse Proxy (Hosted Profile) ---
# Comma-separated list of allowed hostnames accepted in Host and Origin headers.
# Requests with any Host header not in this list are rejected with 421.
# Example: ALLOWED_HOSTS=labs.trainwithshubham.com,learn.tws.com
ALLOWED_HOSTS=

# Reverse proxy trust:
# "1": Trust rightmost X-Forwarded-For header appended by reverse proxy/load balancer (e.g. ALB, Nginx).
# "0": Ignore X-Forwarded-For, use direct socket remoteAddress (default for local).
TRUST_PROXY=0

# --- Authentication & Authorization Policies ---
# LAB_GATED:
# "1": Require valid invite token in header x-lab-token for session creation (default in hosted).
# "0": Allow unauthenticated session creation (default in local).
LAB_GATED=0

# Comma-separated list of secret invite tokens accepted by the server in hosted mode.
# If LAB_GATED=1 and LAB_ACCESS_TOKENS is empty, the server fails closed (no sessions admitted).
# Example: LAB_ACCESS_TOKENS=invite-batch-1,tws-community-2026
LAB_ACCESS_TOKENS=

# PUBLIC_CHALLENGES:
# "1": Decouple standalone challenges from guided lab gating. Allows public access to challenges
#      while guided labs continue to strictly require an invite token.
# "0": Challenges follow guided lab gating (default in hosted).
PUBLIC_CHALLENGES=0

# --- Concurrency & Session Limits ---
# Maximum concurrent learner sessions per server replica (default: 16).
MAX_SESSIONS=16

# Maximum concurrent sessions per client IP address (default: 3 in hosted, 0/unlimited in local).
MAX_SESSIONS_PER_IP=3

# Session idle timeout in minutes (default: 15 local, 5 hosted).
LAB_IDLE_MIN=15

# Maximum session lifetime hard cap in minutes (default: 60 local, 15 hosted).
LAB_HARD_CAP_MIN=60

# --- Resource Bounds & Container Sizing ---
# Container CPU allocation (Docker Compose).
CPUS=1.0

# Container memory allocation (Docker Compose).
MEM_LIMIT=512m

# Container maximum process/task count limit.
PIDS_LIMIT=512

# Size of the executable in-memory tmpfs mounted at /sandbox for learner homes.
SANDBOX_TMPFS_SIZE=128m

# Virtual address space ulimit (-v) inside the learner shell in KB.
# Local defaults to 1048576 (1GB) so node/python can run; hosted defaults to 262144 (256MB).
# Set to 0 to disable.
LAB_ULIMIT_V_KB=

# --- Development & Hot Reloading ---
# "1": Re-read labs/ and challenges/ on every page load (no restart needed when editing YAML/scripts).
# "0": Cache catalog at startup (recommended for hosted production).
LABS_WATCH=1

# --- Observability & Metrics (Optional, Privacy-Preserving) ---
# "1": Enable anonymized session & task counters (no IPs or invite tokens stored).
USAGE_STATS=0

# Bearer token for accessing /admin/stats endpoint (e.g. Authorization: Bearer <ADMIN_TOKEN>).
ADMIN_TOKEN=
